# ─────────────────────────────────────────────────────────────
#  VerifyBot — copy this file to .env and fill in your own values
# ─────────────────────────────────────────────────────────────

# Bot token: Discord Developer Portal → your app → Bot → Reset Token.
# Never commit this. Never share it.
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID: Developer Portal → General Information → Application ID.
CLIENT_ID=your-application-client-id

# OAuth2 client secret: Developer Portal → OAuth2 → Client Secret → Reset Secret.
# This is what lets the callback exchange the authorization code.
CLIENT_SECRET=your-oauth2-client-secret

# The Discord server this bot verifies people in.
# Right-click your server → Copy Server ID (Developer Mode must be on).
GUILD_ID=your-discord-server-id

# Public HTTPS base URL of this bot's web server. No trailing slash.
# Example: https://verify.example.com
# Register this exact callback in Developer Portal → OAuth2 → Redirects:
#   https://verify.example.com/verify/callback
PUBLIC_URL=https://verify.example.com

# Port the Express server listens on. Most hosts inject PORT automatically.
PORT=3000

# ── Roles ────────────────────────────────────────────────────
# Role granted after a successful verification. If empty, the bot looks
# for a role named "Member" (case-insensitive).
MEMBER_ROLE_ID=

# Role removed after verification. If empty, the bot looks for "Unverified"
# and creates it automatically if it does not exist.
UNVERIFIED_ROLE_ID=

# ── Logging ──────────────────────────────────────────────────
# Channel where verification cards are posted. If empty, the bot looks for
# a text channel named "verify-logs".
VERIFY_LOG_CHANNEL_ID=

# true  = reject VPN / proxy / datacenter addresses
# false = allow them, flag them in the log, and never use them to link accounts
BLOCK_VPN=false

# ── Security ─────────────────────────────────────────────────
# Signs the OAuth2 `state` value. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If empty, CLIENT_SECRET is used instead.
STATE_SECRET=

# Set true only when the bot sits behind a reverse proxy / hosting platform
# that sets X-Forwarded-For. Needed to capture the real visitor IP.
TRUST_PROXY=true

# Scopes requested at the Discord consent screen.
# "identify" is enough for verification. Add "email" if you want the log to
# include the account's email address (users can decline it).
VERIFY_SCOPES=identify

# ── Runtime ──────────────────────────────────────────────────
# Where state.json is written. Defaults to ./data
DATA_DIR=./data

# error | warn | info | debug
LOG_LEVEL=info

# Set false if you prefer to push commands manually with `npm run deploy`.
REGISTER_COMMANDS_ON_START=true
